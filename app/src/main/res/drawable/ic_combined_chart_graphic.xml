        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="25"
                android:endX="0"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#40EF4444" />
                <item android:offset="1.0" android:color="#00EF4444" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Red Heart Rate Line -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#EF4444"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M15,55 L40,65 L70,40 L100,60 L130,25 L160,65 L185,65"/>

    <!-- Red Heart Rate Data Points -->
    <path android:fillColor="#EF4444" android:pathData="M15,55m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#EF4444" android:pathData="M40,65m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#EF4444" android:pathData="M70,40m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#EF4444" android:pathData="M100,60m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#EF4444" android:pathData="M130,25m-3,0a3,3 0 1,0 6,0a3,3 0 1,0 -6,0"/>
    <path android:fillColor="#EF4444" android:pathData="M160,65m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#EF4444" android:pathData="M185,65m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>

    <!-- Blue SpO2 Line -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#2563EB"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M15,20 L40,24 L70,16 L100,12 L130,8 L160,22 L185,16"/>

