    <path android:fillColor="#2563EB" android:pathData="M15,20m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#2563EB" android:pathData="M40,24m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#2563EB" android:pathData="M70,16m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#2563EB" android:pathData="M100,12m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#2563EB" android:pathData="M130,8m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
    <path android:fillColor="#2563EB" android:pathData="M160,22m-2,0a2,2 0 1,0 4,0a2,2 0 1,0 -4,0"/>
